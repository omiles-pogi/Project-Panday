{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite dev server",
            "type": "npm",
            "script": "dev",
            "path": "backend",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "laravel serve",
            "type": "shell",
            "command": "php",
            "args": ["artisan", "serve", "--port=8000"],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "laravel",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Server running on"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "dev server",
            "dependsOn": ["vite dev server", "laravel serve"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
