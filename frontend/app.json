{
  "expo": {
    "name": "Project-Panday",
    "slug": "project-panday-mobile",
    "scheme": "project-panday",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1117",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.projectpanday.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      ["expo-image-picker", { "cameraPermission": "Use your camera to take a Project Panday profile photo.", "photosPermission": "Choose a photo for your Project Panday profile.", "microphonePermission": false }],
      "expo-notifications",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
