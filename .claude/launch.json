{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8082"],
      "cwd": "frontend",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8000" },
      "port": 8082
    }
  ]
}
